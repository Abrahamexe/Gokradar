# Neon PostgreSQL — doğrudan bağlantı (tablo oluşturma, toplu yükleme, ingest scriptleri)
# Örnek: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon PostgreSQL — pooler bağlantısı (Flask API)
# Örnek: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=

# OpenSky OAuth2 client credentials dosyasının yolu (proje köküne göre veya mutlak)
# credentials.example.json'ı credentials.json olarak kopyalayıp doldurun (bu dosya git'e girmez).
# Boş bırakılırsa OpenSky devre dışı kalır; harita adsb.lol ile yine çalışır.
OPENSKY_CREDENTIALS_PATH=credentials.json

# Harita karoları (Stadia Maps). localhost'ta boş bırakılabilir; gerçek bir alan adında
# https://client.stadiamaps.com adresinden ücretsiz hesapla alınan anahtar gerekir.
# Not: anahtar tarayıcıya gönderilir (karo URL'sinde); Stadia panelinde alan adına kısıtlayın.
STADIA_API_KEY=

# Uygulama bir ters vekilin (nginx, Cloudflare...) arkasındaysa vekil sayısı (genelde 1).
# Doğrudan internete açıksa 0 bırakın; aksi halde X-Forwarded-For sahtelenebilir.
TRUSTED_PROXY_HOPS=0
